# sing-box-easy 配置文件示例
# 复制此文件为 app.yml 并根据需要修改配置

server:
  # HTTP 服务器端口
  # 可以通过环境变量 HTTP_PORT 覆盖
  # 请确保在云服务商安全组和系统防火墙中放行此端口，以允许从外部访问
  # Ensure this port is open in your cloud provider security group and system firewall to allow external access.
  port: "8080"

sing_box:
  # sing-box 配置文件路径
  # 所有配置管理 API 都会操作此文件
  config_path: "/etc/sing-box/config.json"

  # sing-box 可执行文件路径
  # 留空或设置为 "sing-box" 将使用系统 PATH 中的 sing-box
  # 如果 sing-box 不在 PATH 中，请指定完整路径，例如: "/usr/local/bin/sing-box"
  binary_path: "sing-box"

  # SQLite 数据库文件路径
  # 用于存储订阅信息和初始化状态
  database_path: "/etc/sing-box/sing-box-easy.db"

log:
  # 日志级别: debug | info | warn | error
  # 默认 info。也可通过环境变量 DEBUG=true 强制开启 debug。
  level: "info"