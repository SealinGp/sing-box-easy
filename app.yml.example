# sing-box-easy 配置文件示例
# 复制此文件为 app.yml 并根据需要修改配置

server:
  # HTTP 服务器端口
  # 可以通过环境变量 HTTP_PORT 覆盖
  # 请确保在云服务商安全组和系统防火墙中放行此端口，以允许从外部访问
  # Ensure this port is open in your cloud provider security group and system firewall to allow external access.
  port: "8080"

  # 登录认证模式 / Login requirement:
  #   auto     - 默认。OpenWrt 路由器上关闭登录（面板运行在受信任的局域网），
  #              其他系统上开启登录。
  #              Default: login disabled on OpenWrt routers (trusted LAN),
  #              enabled everywhere else.
  #   enabled  - 始终需要登录 / always require login
  #   disabled - 永不需要登录。任何能访问此端口的人都拥有管理员权限，
  #              仅用于完全可信的网络！
  #              Never require login. Anyone who can reach this port gets
  #              admin access — trusted networks ONLY!
  auth: "auto"

sing_box:
  # sing-box 配置文件路径
  # 所有配置管理 API 都会操作此文件
  config_path: "/etc/sing-box/config.json"

  # sing-box 可执行文件路径
  # 留空或设置为 "sing-box" 将使用系统 PATH 中的 sing-box
  # 如果 sing-box 不在 PATH 中，请指定完整路径，例如: "/usr/local/bin/sing-box"
  binary_path: "sing-box"

  # SQLite 数据库文件路径
  # 用于存储订阅信息和初始化状态
  database_path: "/etc/sing-box/sing-box-easy.db"

log:
  # 日志级别: debug | info | warn | error
  # 默认 info。也可通过环境变量 DEBUG=true 强制开启 debug。
  level: "info"

github:
  # GitHub OAuth App 的 Client ID，用于「使用 GitHub 登录」（OAuth Device Flow）。
  # 登录后检查更新的 API 速率限制从 每 IP 每小时 60 次 提升到 每小时 5000 次。
  #
  # Device Flow 没有 client secret，因此该 ID 是公开的，可以安全地写在配置文件里。
  #
  # 获取方式：
  #   1. https://github.com/settings/developers -> New OAuth App
  #   2. Application name 随意填写；Homepage URL 填仓库地址即可
  #      Authorization callback URL 也可随意填写（Device Flow 不会使用它）
  #   3. 创建后进入该 App 的设置页，勾选 "Enable Device Flow" 并保存
  #   4. 把页面上的 Client ID（形如 Ov23li...）填到下面
  #
  # 留空则不显示登录入口，检查更新回退为受限的匿名访问。
  # 也可通过环境变量 GITHUB_OAUTH_CLIENT_ID 覆盖。
  oauth_client_id: ""

  # 访问 GitHub 时使用的代理，例如 "http://127.0.0.1:7890"。留空表示直连。
  proxy: ""
