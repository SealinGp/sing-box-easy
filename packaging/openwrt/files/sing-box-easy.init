#!/bin/sh /etc/rc.common
# procd init script for the sing-box-easy management panel.
# Installed to /etc/init.d/sing-box-easy by the ipk package.
#
# START=95 keeps the panel after network + firewall; STOP=10 stops it early on
# shutdown. Note this manages the panel only — sing-box itself is started and
# stopped from within the panel.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/sing-box-easy
CONF=/etc/sing-box-easy/app.yml

start_service() {
	[ -x "$PROG" ] || {
		echo "sing-box-easy binary missing: $PROG"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF"
	# Restart on crash: up to 5 retries in 3600s, 5s apart.
	procd_set_param respawn 3600 5 5
	# Forward panel output to syslog (visible via logread).
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
