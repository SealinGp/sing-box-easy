# sing-box-easy 配置文件示例
# 复制此文件为 app.yml 并根据需要修改配置

server:
  # HTTP 服务器端口
  # 可以通过环境变量 HTTP_PORT 覆盖
  port: "8080"

sing_box:
  # sing-box 配置文件路径
  # 所有配置管理 API 都会操作此文件
  config_path: "/etc/sing-box/config.json"

  # sing-box 可执行文件路径
  # 留空或设置为 "sing-box" 将使用系统 PATH 中的 sing-box
  # 如果 sing-box 不在 PATH 中，请指定完整路径，例如: "/usr/local/bin/sing-box"
  binary_path: "sing-box"

  # 订阅配置文件路径
  # 用于存储订阅信息的 JSON 文件
  subscription_path: "/etc/sing-box/subscriptions.json"
